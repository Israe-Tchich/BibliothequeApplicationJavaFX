<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LivreController">

    <top>
        <HBox spacing="10" style="-fx-padding: 10;">
            <TextField fx:id="tfRecherche" promptText="Rechercher titre, auteur, ISBN..."
                       prefWidth="300"/>
            <ComboBox fx:id="cbFiltreCategorie" prefWidth="150"/>
            <Button text="🔍 Rechercher" onAction="#handleRecherche"/>
            <Button text="🔄 Actualiser" onAction="#handleActualiser"/>
        </HBox>
    </top>

    <center>
        <SplitPane>
            <items>
                <!-- Formulaire gauche -->
                <ScrollPane fitToWidth="true">
                    <content>
                        <Accordion>
                            <panes>
                                <TitledPane text="Informations du livre" expanded="true">
                                    <content>
                                        <GridPane hgap="10" vgap="10"
                                                  style="-fx-padding: 10;">
                                            <Label text="Titre *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                            <TextField fx:id="tfTitre" promptText="Titre du livre"
                                                       GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                                            <Label text="Auteur *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                            <TextField fx:id="tfAuteur" promptText="Nom de l'auteur"
                                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                                            <Label text="ISBN" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                                            <TextField fx:id="tfIsbn" promptText="978-X-XX-XXXXXX-X"
                                                       GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                                            <Label text="Catégorie *" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                                            <ComboBox fx:id="cbCategorie" prefWidth="200"
                                                      GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                                            <Label text="Année" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                                            <Spinner fx:id="spAnnee"
                                                     GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                                            <Label text="Exemplaires" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                                            <VBox GridPane.rowIndex="5" GridPane.columnIndex="1">
                                                <Spinner fx:id="spExemplaires"/>
                                                <Slider fx:id="sliderExemplaires" min="1" max="50"/>
                                            </VBox>

                                            <Label text="Disponible" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                                            <CheckBox fx:id="chkDisponible" selected="true"
                                                      GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                                            <Label text="Description" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                                            <TextArea fx:id="taDescription" prefRowCount="3"
                                                      promptText="Description du livre..."
                                                      GridPane.rowIndex="7" GridPane.columnIndex="1"/>
                                        </GridPane>
                                    </content>
                                </TitledPane>

                                <TitledPane text="Statistiques rapides">
                                    <content>
                                        <VBox spacing="10" style="-fx-padding: 10;">
                                            <Label text="Stock disponible :"/>
                                            <ProgressBar fx:id="pbStock" prefWidth="200"/>
                                            <Label text="Catégories :"/>
                                            <ListView fx:id="listCategories" prefHeight="100"/>
                                        </VBox>
                                    </content>
                                </TitledPane>
                            </panes>
                        </Accordion>
                    </content>
                </ScrollPane>

                <!-- Table droite -->
                <VBox spacing="10" style="-fx-padding: 10;">
                    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
                            <TableColumn fx:id="colTitre" text="Titre" prefWidth="180"/>
                            <TableColumn fx:id="colAuteur" text="Auteur" prefWidth="130"/>
                            <TableColumn fx:id="colCategorie" text="Catégorie" prefWidth="100"/>
                            <TableColumn fx:id="colIsbn" text="ISBN" prefWidth="130"/>
                            <TableColumn fx:id="colAnnee" text="Année" prefWidth="60"/>
                            <TableColumn fx:id="colExemplaires" text="Exemplaires" prefWidth="90"/>
                            <TableColumn fx:id="colDisponible" text="Disponible" prefWidth="80"/>
                        </columns>
                    </TableView>

                    <HBox spacing="10">
                        <Button text="➕ Ajouter" onAction="#handleAjouter"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                        <Button text="✏️ Modifier" onAction="#handleModifier"/>
                        <Button text="🗑️ Supprimer" onAction="#handleSupprimer"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                        <Button text="🔄 Vider" onAction="#handleVider"/>
                        <Button text="📥 Export CSV" onAction="#handleExportCSV"/>
                    </HBox>
                </VBox>
            </items>
        </SplitPane>
    </center>

</BorderPane>