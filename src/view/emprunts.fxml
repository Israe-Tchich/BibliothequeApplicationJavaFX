<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.EmpruntController">

    <top>
        <HBox spacing="10" style="-fx-padding: 10;">
            <TextField fx:id="tfRechercheEmprunt" promptText="Rechercher emprunteur..."
                       prefWidth="300"/>
            <ComboBox fx:id="cbFiltreStatut" prefWidth="150"/>
            <Button text="🔍 Rechercher" onAction="#handleRecherche"/>
        </HBox>
    </top>

    <center>
        <SplitPane>
            <items>
                <!-- Formulaire -->
                <ScrollPane fitToWidth="true">
                    <content>
                        <GridPane hgap="10" vgap="10" style="-fx-padding: 10;">
                            <Label text="Livre *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="cbLivre" prefWidth="200"
                                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                            <Label text="Emprunteur *" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                            <TextField fx:id="tfEmprunteur" promptText="Nom de l'emprunteur"
                                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                            <Label text="Date emprunt" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                            <DatePicker fx:id="dpDateEmprunt"
                                        GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                            <Label text="Date retour prévue" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                            <DatePicker fx:id="dpDateRetourPrevue"
                                        GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                            <Label text="Date retour réelle" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                            <DatePicker fx:id="dpDateRetourReelle"
                                        GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                            <Label text="Statut" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                            <ComboBox fx:id="cbStatut" prefWidth="200"
                                      GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                            <Label text="Remarques" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                            <TextArea fx:id="taRemarques" prefRowCount="3"
                                      promptText="Remarques..."
                                      GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                            <HBox spacing="10" GridPane.rowIndex="7" GridPane.columnIndex="0"
                                  GridPane.columnSpan="2">
                                <Button text="➕ Ajouter" onAction="#handleAjouter"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                                <Button text="✏️ Modifier" onAction="#handleModifier"/>
                                <Button text="🗑️ Supprimer" onAction="#handleSupprimer"
                                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                                <Button text="🔄 Vider" onAction="#handleVider"/>
                                <Button text="📥 Export CSV" onAction="#handleExportCSV"/>
                            </HBox>
                        </GridPane>
                    </content>
                </ScrollPane>

                <!-- Table -->
                <VBox spacing="10" style="-fx-padding: 10;">
                    <TableView fx:id="tableEmprunts" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colEmpId" text="ID" prefWidth="40"/>
                            <TableColumn fx:id="colEmpLivre" text="Livre" prefWidth="180"/>
                            <TableColumn fx:id="colEmpEmprunteur" text="Emprunteur" prefWidth="130"/>
                            <TableColumn fx:id="colEmpDateEmprunt" text="Date emprunt" prefWidth="110"/>
                            <TableColumn fx:id="colEmpDateRetour" text="Retour prévu" prefWidth="110"/>
                            <TableColumn fx:id="colEmpStatut" text="Statut" prefWidth="90"/>
                        </columns>
                    </TableView>

                    <HBox spacing="20" style="-fx-padding: 5;">
                        <Label fx:id="lblEnCours" text="En cours : 0"/>
                        <Label fx:id="lblEnRetard" text="En retard : 0"/>
                    </HBox>
                </VBox>
            </items>
        </SplitPane>
    </center>

</BorderPane>